   "code": "// @name        番茄小说（官方接口·免签名）\n// @version     1.1\n// @author      ThirdHub\n// @url         https://fanqienovel.com\n// @type        novel\n// @enabled     true\n\n/* 番茄官方网页接口书源：搜索/目录/正文免签名（浏览器环境直连）。正文与搜索字段含字体反爬字符（Unicode 私用区），\n   用内置字库映射还原（字体 dc027189e0ba4cd 全局固定；映射源自 huixiaheyu/FanqieFetch 的 OCR 字库）。 */\nvar FQ_MAP = {\"58344\":\"d\",\"58345\":\"在\",\"58346\":\"主\",\"58347\":\"特\",\"58348\":\"家\",\"58349\":\"军\",\"58350\":\"然\",\"58351\":\"表\",\"58352\":\"场\",\"58353\":\"4\",\"58354\":\"要\",\"58355\":\"只\",\"58356\":\"v\",\"58357\":\"和\",\"58359\":\"6\",\"58360\":\"别\",\"58361\":\"还\",\"58362\":\"g\",\"58363\":\"现\",\"58364\":\"儿\",\"58365\":\"岁\",\"58368\":\"此\",\"58369\":\"象\",\"58370\":\"月\",\"58371\":\"3\",\"58372\":\"出\",\"58373\":\"战\",\"58374\":\"工\",\"58375\":\"相\",\"58376\":\"o\",\"58377\":\"男\",\"58378\":\"直\",\"58379\":\"失\",\"58380\":\"世\",\"58381\":\"F\",\"58382\":\"都\",\"58383\":\"平\",\"58384\":\"文\",\"58385\":\"什\",\"58386\":\"v\",\"58387\":\"o\",\"58388\":\"将\",\"58389\":\"真\",\"58390\":\"t\",\"58391\":\"那\",\"58392\":\"当\",\"58394\":\"会\",\"58395\":\"立\",\"58396\":\"些\",\"58397\":\"u\",\"58398\":\"是\",\"58399\":\"十\",\"58400\":\"张\",\"58401\":\"学\",\"58402\":\"气\",\"58403\":\"大\",\"58404\":\"爱\",\"58405\":\"两\",\"58406\":\"命\",\"58407\":\"全\",\"58408\":\"后\",\"58409\":\"东\",\"58410\":\"性\",\"58411\":\"通\",\"58412\":\"被\",\"58413\":\"1\",\"58414\":\"它\",\"58415\":\"乐\",\"58416\":\"接\",\"58417\":\"而\",\"58418\":\"感\",\"58419\":\"车\",\"58420\":\"山\",\"58421\":\"公\",\"58422\":\"了\",\"58423\":\"常\",\"58424\":\"以\",\"58425\":\"何\",\"58426\":\"可\",\"58427\":\"话\",\"58428\":\"先\",\"58429\":\"p\",\"58430\":\"i\",\"58431\":\"叫\",\"58432\":\"轻\",\"58433\":\"m\",\"58434\":\"土\",\"58435\":\"w\",\"58436\":\"着\",\"58437\":\"变\",\"58438\":\"尔\",\"58439\":\"快\",\"58440\":\"l\",\"58441\":\"个\",\"58442\":\"说\",\"58443\":\"少\",\"58444\":\"色\",\"58445\":\"里\",\"58446\":\"安\",\"58447\":\"花\",\"58448\":\"远\",\"58449\":\"7\",\"58450\":\"难\",\"58451\":\"师\",\"58452\":\"放\",\"58453\":\"t\",\"58454\":\"报\",\"58455\":\"认\",\"58456\":\"面\",\"58457\":\"道\",\"58458\":\"s\",\"58460\":\"克\",\"58461\":\"地\",\"58462\":\"度\",\"58463\":\"l\",\"58464\":\"好\",\"58465\":\"机\",\"58466\":\"U\",\"58467\":\"民\",\"58468\":\"写\",\"58469\":\"把\",\"58470\":\"万\",\"58471\":\"同\",\"58472\":\"水\",\"58473\":\"新\",\"58474\":\"没\",\"58475\":\"书\",\"58476\":\"电\",\"58477\":\"吃\",\"58478\":\"像\",\"58479\":\"斯\",\"58480\":\"5\",\"58481\":\"为\",\"58482\":\"y\",\"58483\":\"自\",\"58484\":\"几\",\"58485\":\"日\",\"58486\":\"教\",\"58487\":\"看\",\"58488\":\"但\",\"58489\":\"第\",\"58490\":\"加\",\"58491\":\"候\",\"58492\":\"作\",\"58493\":\"上\",\"58494\":\"拉\",\"58495\":\"住\",\"58496\":\"有\",\"58497\":\"法\",\"58498\":\"r\",\"58499\":\"事\",\"58500\":\"应\",\"58501\":\"位\",\"58502\":\"利\",\"58503\":\"你\",\"58504\":\"声\",\"58505\":\"身\",\"58506\":\"国\",\"58507\":\"问\",\"58508\":\"马\",\"58509\":\"女\",\"58510\":\"他\",\"58511\":\"y\",\"58512\":\"比\",\"58513\":\"父\",\"58514\":\"x\",\"58515\":\"a\",\"58516\":\"H\",\"58517\":\"N\",\"58518\":\"s\",\"58519\":\"x\",\"58520\":\"边\",\"58521\":\"美\",\"58522\":\"对\",\"58523\":\"所\",\"58524\":\"金\",\"58525\":\"活\",\"58526\":\"回\",\"58527\":\"意\",\"58528\":\"到\",\"58529\":\"z\",\"58530\":\"从\",\"58531\":\"j\",\"58532\":\"知\",\"58533\":\"又\",\"58534\":\"内\",\"58535\":\"因\",\"58536\":\"点\",\"58537\":\"Q\",\"58538\":\"三\",\"58539\":\"定\",\"58540\":\"8\",\"58541\":\"r\",\"58542\":\"b\",\"58543\":\"正\",\"58544\":\"或\",\"58545\":\"夫\",\"58546\":\"向\",\"58547\":\"德\",\"58548\":\"听\",\"58549\":\"更\",\"58551\":\"得\",\"58552\":\"告\",\"58553\":\"并\",\"58554\":\"本\",\"58555\":\"q\",\"58556\":\"过\",\"58557\":\"记\",\"58558\":\"L\",\"58559\":\"让\",\"58560\":\"打\",\"58561\":\"f\",\"58562\":\"人\",\"58563\":\"就\",\"58564\":\"者\",\"58565\":\"去\",\"58566\":\"原\",\"58567\":\"满\",\"58568\":\"体\",\"58569\":\"做\",\"58570\":\"经\",\"58571\":\"k\",\"58572\":\"走\",\"58573\":\"如\",\"58574\":\"孩\",\"58575\":\"c\",\"58576\":\"g\",\"58577\":\"给\",\"58578\":\"使\",\"58579\":\"物\",\"58581\":\"最\",\"58582\":\"笑\",\"58583\":\"部\",\"58585\":\"员\",\"58586\":\"等\",\"58587\":\"受\",\"58588\":\"k\",\"58589\":\"行\",\"58590\":\"一\",\"58591\":\"条\",\"58592\":\"果\",\"58593\":\"动\",\"58594\":\"光\",\"58595\":\"门\",\"58596\":\"头\",\"58597\":\"见\",\"58598\":\"往\",\"58599\":\"自\",\"58600\":\"解\",\"58601\":\"成\",\"58602\":\"处\",\"58603\":\"天\",\"58604\":\"能\",\"58605\":\"于\",\"58606\":\"名\",\"58607\":\"其\",\"58608\":\"发\",\"58609\":\"总\",\"58610\":\"母\",\"58611\":\"的\",\"58612\":\"死\",\"58613\":\"手\",\"58614\":\"入\",\"58615\":\"路\",\"58616\":\"进\",\"58617\":\"心\",\"58618\":\"来\",\"58619\":\"h\",\"58620\":\"时\",\"58621\":\"力\",\"58622\":\"多\",\"58623\":\"开\",\"58624\":\"已\",\"58625\":\"许\",\"58626\":\"d\",\"58627\":\"至\",\"58628\":\"由\",\"58629\":\"很\",\"58630\":\"界\",\"58631\":\"n\",\"58632\":\"小\",\"58633\":\"与\",\"58634\":\"z\",\"58635\":\"想\",\"58636\":\"代\",\"58637\":\"么\",\"58638\":\"分\",\"58639\":\"生\",\"58640\":\"口\",\"58641\":\"再\",\"58642\":\"妈\",\"58643\":\"望\",\"58644\":\"次\",\"58645\":\"西\",\"58646\":\"风\",\"58647\":\"种\",\"58648\":\"带\",\"58649\":\"J\",\"58651\":\"实\",\"58652\":\"情\",\"58653\":\"才\",\"58654\":\"这\",\"58656\":\"e\",\"58657\":\"我\",\"58658\":\"神\",\"58659\":\"格\",\"58660\":\"长\",\"58661\":\"觉\",\"58662\":\"间\",\"58663\":\"年\",\"58664\":\"眼\",\"58665\":\"无\",\"58666\":\"不\",\"58667\":\"亲\",\"58668\":\"关\",\"58669\":\"结\",\"58670\":\"0\",\"58671\":\"友\",\"58672\":\"信\",\"58673\":\"下\",\"58674\":\"却\",\"58675\":\"重\",\"58676\":\"己\",\"58677\":\"老\",\"58678\":\"2\",\"58679\":\"音\",\"58680\":\"字\",\"58681\":\"m\",\"58682\":\"呢\",\"58683\":\"明\",\"58684\":\"之\",\"58685\":\"前\",\"58686\":\"高\",\"58687\":\"p\",\"58688\":\"b\",\"58689\":\"目\",\"58690\":\"太\",\"58691\":\"e\",\"58692\":\"9\",\"58693\":\"起\",\"58694\":\"棱\",\"58695\":\"她\",\"58696\":\"也\",\"58697\":\"w\",\"58698\":\"用\",\"58699\":\"方\",\"58700\":\"子\",\"58701\":\"英\",\"58702\":\"每\",\"58703\":\"理\",\"58704\":\"便\",\"58705\":\"四\",\"58706\":\"数\",\"58707\":\"期\",\"58708\":\"中\",\"58709\":\"c\",\"58710\":\"外\",\"58711\":\"样\",\"58712\":\"a\",\"58713\":\"海\",\"58714\":\"们\",\"58715\":\"任\"};\n\nfunction fqDecode(s) {\n  if (!s) return '';\n  return Array.from(String(s)).map(function (ch) {\n    var cp = ch.codePointAt(0);\n    return (cp >= 0xE000 && cp <= 0xF8FF && FQ_MAP[cp]) ? FQ_MAP[cp] : ch;\n  }).join('');\n}\n\nasync function fqGet(url, ref) {\n  var r = await fetch(url, { headers: { 'Referer': ref || 'https://fanqienovel.com/', 'User-Agent': (navigator && navigator.userAgent) || 'Mozilla/5.0', 'Accept': 'application/json, text/plain, */*' } });\n  if (!r.ok) throw new Error('HTTP ' + r.status);\n  var t = await r.text();\n  if (!t) throw new Error('空响应（风控或网络异常）');\n  return JSON.parse(t);\n}\n\nfunction bookIdOf(u) { var m = String(u || '').match(/page\\/(\\d+)/); return m ? m[1] : ''; }\nfunction itemIdOf(u) { var m = String(u || '').match(/reader\\/(\\d+)/); return m ? m[1] : ''; }\n\nasync function search(keyword, page) {\n  var qs = 'filter=' + encodeURIComponent('127,127,127,127') + '&page_count=10&page_index=' + ((page || 1) - 1) + '&query_type=0&query_word=' + encodeURIComponent(keyword);\n  var j = await fqGet('https://fanqienovel.com/api/author/search/search_book/v1?' + qs);\n  var list = (j.data && j.data.search_book_data_list) || [];\n  return list.map(function (b) {\n    return {\n      name: fqDecode(b.book_name),\n      author: fqDecode(b.author),\n      coverUrl: b.thumb_url || '',\n      bookUrl: 'https://fanqienovel.com/page/' + b.book_id,\n      intro: fqDecode(b.book_abstract),\n      kind: b.category || '',\n      type: 'novel',\n    };\n  });\n}\n\nasync function bookInfo(bookUrl) {\n  var id = bookIdOf(bookUrl);\n  var empty = { name: '', author: '', intro: '', coverUrl: '', kind: '', lastUpdate: '' };\n  if (!id) return empty;\n  var r = await fetch(bookUrl, { headers: { 'User-Agent': (navigator && navigator.userAgent) || 'Mozilla/5.0' } });\n  var html = await r.text();\n  var i0 = html.indexOf('__INITIAL_STATE__');\n  if (i0 < 0) return empty;\n  var raw = html.slice(html.indexOf('=', i0) + 1);\n  /* 括号平衡截取完整 JSON（INITIAL_STATE 后还有其它脚本语句） */\n  var depth = 0, inStr = false, esc = false, end = -1;\n  for (var k = 0; k < raw.length; k++) {\n    var ch = raw[k];\n    if (esc) { esc = false; continue; }\n    if (inStr) { if (ch === '\\\\') esc = true; else if (ch === '\"') inStr = false; continue; }\n    if (ch === '\"') inStr = true;\n    else if (ch === '{') depth++;\n    else if (ch === '}') { depth--; if (depth === 0) { end = k + 1; break; } }\n  }\n  if (end <= 0) return empty;\n  var st = null;\n  try { st = JSON.parse(raw.slice(0, end).replace(/<\\/script>/gi, '<\\\\/script>')); } catch (e) {}\n  if (!st) return empty;\n  var p = st.page || {};\n  return {\n    name: p.bookName || '',\n    author: p.author || '',\n    intro: String(p.description || '').replace(/<[^>]+>/g, ''),\n    coverUrl: p.thumbUrl || p.coverUrl || '',\n    kind: String(p.categoryV2 || '').replace(/[\\\"{}]/g, '').slice(0, 60),\n    lastUpdate: p.lastChapterTime ? new Date(p.lastChapterTime * 1000).toLocaleDateString() : '',\n  };\n}\n\nasync function chapterList(bookUrl) {\n  var id = bookIdOf(bookUrl);\n  if (!id) return [];\n  var j = await fqGet('https://fanqienovel.com/api/reader/directory/detail?bookId=' + id);\n  var vols = (j.data && j.data.chapterListWithVolume) || [];\n  var out = [];\n  for (var vi = 0; vi < vols.length; vi++) {\n    var vol = vols[vi] || [];\n    for (var ci = 0; ci < vol.length; ci++) {\n      var c = vol[ci];\n      if (!c || !c.itemId) continue;\n      out.push({ name: c.title || ('第' + (ci + 1) + '章'), url: 'https://fanqienovel.com/reader/' + c.itemId, vip: !!c.needPay });\n    }\n  }\n  return out;\n}\n\nasync function chapterContent(chapterUrl) {\n  var id = itemIdOf(chapterUrl);\n  if (!id) return '<p>无效章节地址</p>';\n  var j = await fqGet('https://fanqienovel.com/api/reader/full?itemId=' + id, 'https://fanqienovel.com/reader/' + id);\n  var cd = (j.data && j.data.chapterData) || {};\n  var html = cd.content || '';\n  if (!html) return '<p>正文获取失败</p>';\n  return html.replace(/>([^<]+)</g, function (all, text) { return '>' + fqDecode(text) + '<'; });\n}"
